<section class="volt-home-top" aria-labelledby="volt-hero-title">
    <div class="container">
        <div class="volt-hero">
            <div class="volt-hero__copy">
                <p class="volt-hero__eyebrow">{{ 'volt.hero.eyebrow'|trans({}, 'volt') }}</p>
                <h1 id="volt-hero-title">{{ 'volt.hero.title'|trans({}, 'volt')|raw }}</h1>
                <p class="volt-hero__lead">{{ 'volt.hero.lead'|trans({}, 'volt') }}</p>
                <a class="volt-hero__cta" href="#volt-products">
                    {{ 'volt.hero.cta'|trans({}, 'volt') }}
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                </a>
            </div>
            <div class="volt-hero__orbit" aria-hidden="true">
                <div class="volt-hero__disc">V</div>
                <span class="volt-hero__tag">{{ 'volt.hero.tag'|trans({}, 'volt') }}</span>
            </div>
        </div>

        <ul class="volt-perks" role="list">
            <li>
                <span class="volt-perks__icon"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M13 2 4 14h7l-1 8 9-12h-7l1-8Z"/></svg></span>
                <span><strong>{{ 'volt.perks.shipping.title'|trans({}, 'volt') }}</strong>{{ 'volt.perks.shipping.text'|trans({}, 'volt') }}</span>
            </li>
            <li>
                <span class="volt-perks__icon"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 12a8 8 0 1 0 2.35-5.65"/><path d="M4 4v4h4"/></svg></span>
                <span><strong>{{ 'volt.perks.returns.title'|trans({}, 'volt') }}</strong>{{ 'volt.perks.returns.text'|trans({}, 'volt') }}</span>
            </li>
            <li>
                <span class="volt-perks__icon"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="4" y="10" width="16" height="11" rx="3"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg></span>
                <span><strong>{{ 'volt.perks.payment.title'|trans({}, 'volt') }}</strong>{{ 'volt.perks.payment.text'|trans({}, 'volt') }}</span>
            </li>
        </ul>
    </div>
</section>
