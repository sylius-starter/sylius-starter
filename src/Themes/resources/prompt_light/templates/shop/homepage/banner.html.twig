<section class="container prompt-hero" aria-label="{{ 'sylius.ui.home'|trans }}">
    <div class="prompt-hero__copy">
        <p class="prompt-hero__eyebrow">PROMPT / EVERYDAY GOODS</p>
        <h1>Good things.<br>Ready when you are.</h1>
        <p class="prompt-hero__description">A considered collection of everyday essentials, picked for the way you live.</p>
        <a class="btn btn-primary" href="#prompt-products">{{ 'sylius.ui.view_all_products'|trans }}</a>
    </div>

    <div class="prompt-terminal" aria-label="Prompt terminal">
        <div class="prompt-terminal__bar" aria-hidden="true">
            <span class="prompt-terminal__dot"></span>
            <span class="prompt-terminal__dot"></span>
            <span class="prompt-terminal__dot"></span>
            <span class="prompt-terminal__label">storefront — prompt_light</span>
        </div>
        <div class="prompt-terminal__body">
            <span class="prompt-terminal__command">castor sylius:theme:setup prompt_light</span>
            <p class="prompt-terminal__result"><strong>✓ storefront theme applied</strong></p>
            <span class="prompt-terminal__command">sylius shop:discover</span>
            <p class="prompt-terminal__result"><strong>✓</strong> thoughtful goods, no extra noise</p>
            <span class="prompt-terminal__command">sylius cart:add --item=your-next-favorite</span>
            <p class="prompt-terminal__result"><strong>✓</strong> good choice.</p>
        </div>
    </div>
</section>
