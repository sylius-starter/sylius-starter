{% set product = hookable_metadata.context.product %}

{% for association in product.associations %}
    {{ component('sylius_shop:product:association', {productAssociation: association, template: 'shop/product/show/content/product_listing/association.html.twig'}) }}
{% else %}
    {{ component('sylius_shop:product:list', {limit: 4, template: 'shop/product/common/list.html.twig'}) }}
{% endfor %}
