{% set lagoon_list_key = hookable_metadata.configuration['test_attribute']|default('latest-products') %}
{% set lagoon_eyebrows = {'latest-deals': 'lagoon.products.eyebrow.deals', 'latest-products': 'lagoon.products.eyebrow.latest'} %}

<section id="lagoon-{{ lagoon_list_key }}" class="lagoon-products lagoon-products--{{ lagoon_list_key }}">
    <div class="container" role="region" aria-labelledby="{{ lagoon_list_key ~ '-heading' }}">
        <div class="lagoon-section-head">
            {% if lagoon_eyebrows[lagoon_list_key] is defined %}
                <p class="lagoon-eyebrow">{{ lagoon_eyebrows[lagoon_list_key]|trans({}, 'lagoon') }}</p>
            {% endif %}
            <h2 id="{{ lagoon_list_key ~ '-heading' }}">{{ hookable_metadata.configuration.title|default('sylius.ui.latest_products')|trans }}</h2>
        </div>

        <div {{ sylius_test_html_attribute(hookable_metadata.configuration.test_attribute|default('latest-products')) }}>
            <div class="products-grid">
                {% for product in latest_products %}
                    <div>{{ component('sylius_shop:product:card', {product: product, template: hookable_metadata.configuration.product_template|default('@SyliusShop/product/common/card.html.twig'), hookableMetadata: hookable_metadata}) }}</div>
                {% endfor %}
            </div>
        </div>
    </div>
</section>
