<div class="container">
    <section class="blush-hero" aria-label="{{ 'sylius.ui.home'|trans }}">
        <div class="blush-hero__copy">
            <p class="blush-hero__eyebrow">{{ 'blush.hero.eyebrow'|trans({}, 'blush') }}</p>
            <h1>{{ 'blush.hero.title'|trans({}, 'blush')|raw }}</h1>
            <p class="blush-hero__description">{{ 'blush.hero.description'|trans({}, 'blush') }}</p>
            <a class="btn btn-primary" href="#blush-products">{{ 'blush.hero.cta'|trans({}, 'blush') }}</a>
        </div>
        <div class="blush-hero__art" aria-hidden="true">
            <span class="blush-hero__art-label">{{ 'blush.hero.label'|trans({}, 'blush') }}</span>
            <div class="blush-hero__disc">B</div>
            <span class="blush-hero__spark">✳</span>
        </div>
    </section>
</div>
