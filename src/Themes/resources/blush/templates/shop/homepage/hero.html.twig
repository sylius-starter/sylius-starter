{# Theme markup for the core hero slot (StorefrontHero). `hero` holds contributed data (import...); theme copy is the fallback. #}
<div class="container">
    <section class="blush-hero" aria-label="{{ 'sylius.ui.home'|trans }}">
        <div class="blush-hero__copy">
            <p class="blush-hero__eyebrow">{% if hero.eyebrow %}{{ hero.eyebrow }}{% else %}{{ 'blush.hero.eyebrow'|trans({}, 'blush') }}{% endif %}</p>
            <h1>{% if hero.title %}{{ hero.title }}{% else %}{{ 'blush.hero.title'|trans({}, 'blush')|raw }}{% endif %}</h1>
            <p class="blush-hero__description">{% if hero.lead %}{{ hero.lead }}{% else %}{{ 'blush.hero.description'|trans({}, 'blush') }}{% endif %}</p>
            <a class="btn btn-primary" href="{{ hero.ctaUrl ?? '#blush-products' }}">{% if hero.ctaLabel %}{{ hero.ctaLabel }}{% else %}{{ 'blush.hero.cta'|trans({}, 'blush') }}{% endif %}</a>
        </div>
        {% if hero.image %}
            <img class="blush-hero__image" src="{{ hero.image }}" alt="{{ hero.imageAlt ?? '' }}">
        {% else %}
            <div class="blush-hero__art" aria-hidden="true">
                <span class="blush-hero__art-label">{{ 'blush.hero.label'|trans({}, 'blush') }}</span>
                <div class="blush-hero__disc">B</div>
                <span class="blush-hero__spark">✳</span>
            </div>
        {% endif %}
    </section>
</div>
