{# Generated by sylius-starter/core: fallback hero when no theme provides shop/homepage/hero.html.twig. #}
{% if hero.empty %}
    {{ include('@SyliusShop/homepage/banner.html.twig') }}
{% else %}
    <div class="mb-6" role="banner" aria-label="{{ 'sylius.ui.home'|trans }}">
        {% if hero.image %}
            <img src="{{ hero.image }}" alt="{{ hero.imageAlt ?? '' }}" class="img-fluid w-100"{% if not hero.imageAlt %} role="presentation"{% endif %}>
        {% endif %}

        {% if hero.title or hero.lead or hero.ctaLabel %}
            <div class="container py-5 text-center">
                {% if hero.eyebrow %}<p class="text-uppercase small mb-2">{{ hero.eyebrow }}</p>{% endif %}
                {% if hero.title %}<h1>{{ hero.title }}</h1>{% endif %}
                {% if hero.lead %}<p class="lead">{{ hero.lead }}</p>{% endif %}
                {% if hero.ctaLabel and hero.ctaUrl %}
                    <a class="btn btn-primary" href="{{ hero.ctaUrl }}">{{ hero.ctaLabel }}</a>
                {% endif %}
            </div>
        {% endif %}
    </div>
{% endif %}
