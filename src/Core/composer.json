{
    "name": "sylius-starter/core",
    "description": "Sylius Starter core: Castor plugin providing the Sylius Docker service, installer and shared utilities",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "sylius",
        "castor",
        "starter"
    ],
    "homepage": "https://github.com/sylius-starter/sylius-starter",
    "authors": [
        {
            "name": "Loïc Frémont",
            "email": "lfremont@jolicode.com"
        }
    ],
    "require": {
        "php": ">=8.3",
        "castor-php/docker": "^0.6.0",
        "nikic/php-parser": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "SyliusStarter\\Core\\": "src/"
        },
        "files": [
            "src/Installer/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "SyliusStarter\\Core\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1-dev"
        }
    }
}
