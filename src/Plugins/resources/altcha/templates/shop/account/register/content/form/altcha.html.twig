{#
    The registration form is a LiveComponent: each re-render would add a new widget,
    because the ALTCHA widget gets a random id. "data-live-ignore" (with a stable id)
    keeps the widget, its script and the solved payload untouched between re-renders.
#}
<fieldset id="sylius-shop-register-altcha" class="mb-5 mb-md-9" data-live-ignore>
    <div class="row gx-5">
        <div class="col-12 col-md-6">
            {{ form_row(hookable_metadata.context.form.altcha, sylius_test_form_attribute('altcha')) }}
        </div>
    </div>
</fieldset>
